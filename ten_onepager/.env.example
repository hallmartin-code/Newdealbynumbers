# Copy to .env (same folder) and fill in. Never commit .env.

# Required for AI analysis. Without it the app runs in demo mode only.
# Claude Code does not provide runtime credentials; use your own API key.
ANTHROPIC_API_KEY=

# Optional: model and effort (defaults: claude-opus-5-5, medium).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=32000

# Optional: decks longer than this many characters are condensed chunk by chunk.
# ONEPAGER_MAX_CHARS=150000

# Optional: turn on OCR for scanned PDF pages by default (needs Tesseract).
# ONEPAGER_OCR=false
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
